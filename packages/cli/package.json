{
  "name": "@stellarbooks/cli",
  "version": "0.0.0",
  "description": "Command-line interface for StellarBooks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stellarbooks": "./dist/bin.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@stellarbooks/core": "workspace:*",
    "@stellarbooks/reports": "workspace:*",
    "@stellarbooks/stellar-ingest": "workspace:*",
    "@stellarbooks/storage-postgres": "workspace:*"
  }
}
