{
  "name": "stellarbooks-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Turns Stellar network activity into auditable double-entry accounting records (monorepo root).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "typedoc",
    "audit": "pnpm audit --audit-level moderate",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run docs:api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
